      },
      {
        "id": "w7",
        "field": "arp.ip",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "IPs"
      },
      {
        "id": "w8",
        "field": "mac.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Source MACs"
      },
      {
        "id": "w9",
        "field": "mac.dst",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Destination MACs"
      },
      {
        "id": "w10",
        "field": "mac.src",
        "fields": [
          "mac.src",
          "mac.dst",
          "arp.opcode",
          "arp.ip",
          "arp.mac",
