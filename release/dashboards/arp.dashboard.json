        "width": 3,
        "height": 2,
        "title": "ARP sessions by arp.opcode (1 request, 2 reply)"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "ARP sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "ARP packets",
        "metricType": "packets"
      },
      {
        "id": "w4",
        "field": "arp.ip",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "IPs"
      },
      {
        "id": "w5",
        "field": "arp.oui",
