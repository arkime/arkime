{
  "name": "RADIUS",
  "description": "RADIUS sessions: protocols == radius",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == radius",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "radius.msgType",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "RADIUS sessions by radius.msgType"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "RADIUS sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "RADIUS bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "radius.user",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Users"
      },
      {
        "id": "w5",
        "field": "radius.msgType",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "Message types"
      },
      {
        "id": "w6",
        "field": "radius.nasIp",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "NAS IPs"
      },
      {
        "id": "w7",
        "field": "radius.framed-ip",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Framed IPs"
      },
      {
        "id": "w8",
        "field": "radius.mac",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Client MACs"
      },
      {
        "id": "w9",
        "field": "radius.endpoint-ip",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Endpoint IPs"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w11",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "radius.user",
          "radius.msgType",
          "radius.nasIp",
          "radius.framed-ip"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
