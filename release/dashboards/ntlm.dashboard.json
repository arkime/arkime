{
  "name": "NTLM",
  "description": "NTLM sessions: protocols == ntlm",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == ntlm",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "ntlm.type",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "NTLM sessions by ntlm.type"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "NTLM sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "NTLM bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "ntlm.host",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Hosts"
      },
      {
        "id": "w5",
        "field": "ntlm.domain",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "Domains"
      },
      {
        "id": "w6",
        "field": "ntlm.targetName",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Target names"
      },
      {
        "id": "w7",
        "field": "ntlm.version",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Versions"
      },
      {
        "id": "w8",
        "field": "ntlm.dnsDomainName",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "DNS domains"
      },
      {
        "id": "w9",
        "field": "ntlm.nbComputerName",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "NetBIOS computer names"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w11",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst"
        ],
        "viewMode": "tree",
        "width": 4,
        "height": 3,
        "length": 500,
        "treeDepth": 3,
        "title": "NTLM tree: who authenticated where (click a host to re-root)"
      },
      {
        "id": "w13",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "ntlm.domain",
          "ntlm.host",
          "ntlm.targetName",
          "ntlm.type"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
