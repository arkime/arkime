{
  "name": "SMB",
  "description": "SMB sessions: protocols == smb",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == smb",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "smb.dialect",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "SMB sessions by smb.dialect"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "SMB sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "SMB bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "smb.share",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20
      },
      {
        "id": "w5",
        "field": "smb.dialect",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true
      },
      {
        "id": "w6",
        "field": "smb.fn",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Files"
      },
      {
        "id": "w7",
        "field": "smb.user",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Users"
      },
      {
        "id": "w8",
        "field": "smb.os",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Operating systems"
      },
      {
        "id": "w9",
        "field": "host.smb",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Hosts"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w11",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst"
        ],
        "viewMode": "tree",
        "width": 4,
        "height": 3,
        "length": 500,
        "treeDepth": 3,
        "title": "SMB tree: who reached what (click a host to re-root)"
      },
      {
        "id": "w13",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "smb.user",
          "smb.share",
          "smb.fn"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
