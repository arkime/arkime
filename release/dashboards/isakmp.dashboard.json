{
  "name": "IPsec IKE",
  "description": "IPsec IKE / ISAKMP sessions: protocols == isakmp",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == isakmp",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "isakmp.exchange-type",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "IPsec IKE sessions by isakmp.exchange-type"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "IPsec IKE sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "IPsec IKE bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "isakmp.vendor-id",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Vendor IDs"
      },
      {
        "id": "w5",
        "field": "isakmp.version",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "IKE versions"
      },
      {
        "id": "w6",
        "field": "isakmp.encryption",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Encryption"
      },
      {
        "id": "w7",
        "field": "isakmp.dh-group",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "DH groups"
      },
      {
        "id": "w8",
        "field": "isakmp.hash",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Hashes"
      },
      {
        "id": "w9",
        "field": "isakmp.auth-method",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Authentication methods"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w11",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "isakmp.version",
          "isakmp.exchange-type",
          "isakmp.encryption",
          "isakmp.dh-group"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
