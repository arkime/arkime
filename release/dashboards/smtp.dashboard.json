        "width": 3,
        "height": 2,
        "title": "SMTP sessions by host.email"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "SMTP sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "SMTP bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "email.subject",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20
      },
      {
        "id": "w5",
        "field": "email.content-type",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true
      },
      {
        "id": "w6",
        "field": "email.src",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Senders"
      },
      {
        "id": "w7",
        "field": "email.dst",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Recipients"
      },
      {
        "id": "w8",
        "field": "email.fn",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Attachments"
      },
      {
        "id": "w9",
        "field": "email.x-mailer",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Mailers"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
