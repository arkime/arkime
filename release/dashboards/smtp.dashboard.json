        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "email.src",
          "email.dst",
          "email.subject",
          "email.fn"
