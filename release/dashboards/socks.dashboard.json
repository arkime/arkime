      },
      {
        "id": "w8",
        "field": "socks.user",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Users"
      },
      {
        "id": "w9",
        "field": "socks.status",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "Results"
      },
      {
        "id": "w10",
        "field": "ip.src",
