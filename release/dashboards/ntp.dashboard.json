{
  "name": "NTP",
  "description": "NTP sessions: protocols == ntp",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == ntp",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "ntp.mode",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "NTP sessions by ntp.mode"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "NTP sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "NTP bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "ntp.ref-id",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Reference IDs"
      },
      {
        "id": "w5",
        "field": "ntp.stratum",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true
      },
      {
        "id": "w6",
        "field": "ntp.version",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "Versions"
      },
      {
        "id": "w7",
        "field": "ntp.poll",
        "viewMode": "bar",
        "width": 2,
        "height": 2,
        "length": 15,
        "title": "Polling intervals"
      },
      {
        "id": "w8",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w9",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "ntp.mode",
          "ntp.stratum",
          "ntp.version",
          "ntp.ref-id"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
