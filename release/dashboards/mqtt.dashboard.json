{
  "name": "MQTT",
  "description": "MQTT sessions: protocols == mqtt",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == mqtt",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "mqtt.type",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "MQTT sessions by mqtt.type"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "MQTT sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "MQTT bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "mqtt.topic",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Topics"
      },
      {
        "id": "w5",
        "field": "mqtt.version",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "Versions"
      },
      {
        "id": "w6",
        "field": "mqtt.clientId",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Client IDs"
      },
      {
        "id": "w7",
        "field": "mqtt.topic",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Topics"
      },
      {
        "id": "w8",
        "field": "mqtt.qos",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "QoS"
      },
      {
        "id": "w9",
        "field": "mqtt.connackCode",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "CONNACK codes"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w11",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "mqtt.clientId",
          "mqtt.type",
          "mqtt.topic"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
