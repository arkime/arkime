{
  "name": "TLS",
  "description": "TLS sessions: protocols == tls",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == tls",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "tls.version",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "TLS sessions by tls.version"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "TLS sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "TLS bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "cert.subject.cn",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20
      },
      {
        "id": "w5",
        "field": "tls.cipher",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true
      },
      {
        "id": "w6",
        "field": "tls.alpn",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "ALPN"
      },
      {
        "id": "w7",
        "field": "tls.version",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true
      },
      {
        "id": "w8",
        "field": "tls.ja4",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20
      },
      {
        "id": "w9",
        "field": "tls.ja3",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20
      },
      {
        "id": "w10",
        "field": "cert.issuer.on",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Certificate issuers"
      },
      {
        "id": "w11",
        "field": "cert.remainingDays",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 20,
        "bucketInterval": 30,
        "title": "Days until certificate expiry (ranges of 30)"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w13",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w14",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "tls.version",
          "tls.cipher",
          "cert.subject.cn",
          "tls.ja4"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
