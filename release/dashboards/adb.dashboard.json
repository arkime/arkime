{
  "name": "ADB",
  "description": "Android Debug Bridge sessions: protocols == adb",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == adb",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "adb.command",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "ADB sessions by adb.command"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "ADB sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "ADB bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "adb.serial",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Device serials"
      },
      {
        "id": "w5",
        "field": "adb.systemtype",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true,
        "title": "System types"
      },
      {
        "id": "w6",
        "field": "adb.service",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Services"
      },
      {
        "id": "w7",
        "field": "adb.sync.path",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Synced paths"
      },
      {
        "id": "w8",
        "field": "adb.shell.exitcode",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Shell exit codes"
      },
      {
        "id": "w9",
        "field": "adb.forward.remote",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "Forwarded remotes"
      },
      {
        "id": "w10",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w11",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w12",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "adb.command",
          "adb.serial",
          "adb.service",
          "adb.systemtype"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
