{
  "name": "Software",
  "description": "Client and server software seen on the wire: user agents, versions and operating systems",
  "data": {
    "version": 1,
    "folder": "Analysis",
    "colorScheme": "rainbow",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "http.user-agent",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 4,
        "height": 2,
        "title": "User agent share over time",
        "yScale": "percent"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "HTTP user agents",
        "expression": "http.user-agent == EXISTS!"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "SSH versions",
        "expression": "ssh.ver == EXISTS!"
      },
      {
        "id": "w4",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "SMB operating systems",
        "expression": "smb.os == EXISTS!"
      },
      {
        "id": "w5",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "DHCP class IDs",
        "expression": "dhcp.classId == EXISTS!"
      },
      {
        "id": "w6",
        "field": "http.user-agent",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "HTTP user agents"
      },
      {
        "id": "w7",
        "field": "quic.user-agent",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "QUIC user agents"
      },
      {
        "id": "w8",
        "field": "ssh.ver.src",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "SSH clients"
      },
      {
        "id": "w9",
        "field": "ssh.ver.dst",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "SSH servers"
      },
      {
        "id": "w10",
        "field": "smb.os",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "SMB operating systems"
      },
      {
        "id": "w11",
        "field": "smb.ver",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "SMB versions"
      },
      {
        "id": "w12",
        "field": "dhcp.classId",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "DHCP class IDs"
      },
      {
        "id": "w13",
        "field": "rdp.client-build",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "RDP client builds"
      },
      {
        "id": "w14",
        "field": "sip.user-agent",
        "viewMode": "table",
        "width": 2,
        "height": 2,
        "length": 20,
        "title": "SIP user agents"
      },
      {
        "id": "w15",
        "field": "ssdp.server",
        "viewMode": "table",
