      {
        "id": "w9",
        "field": "ip",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Top IPs"
      },
      {
        "id": "w10",
        "field": "protocols",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 12,
        "title": "Protocols"
      },
      {
        "id": "w11",
        "field": "ip.dst:port",
