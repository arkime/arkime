{
  "name": "Overview",
  "description": "The starter dashboard: capture statistics, top talkers, protocols and the session timeline",
  "data": {
    "version": 1,
    "colorScheme": "rainbow",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "field": "protocols",
        "viewMode": "control",
        "width": 2,
        "height": 1,
        "length": 20,
        "title": "Protocols"
      },
      {
        "id": "w2",
        "field": "node",
        "viewMode": "control",
        "width": 2,
        "height": 1,
        "length": 20,
        "title": "Capture nodes"
      },
      {
        "id": "w3",
        "viewMode": "stats",
        "width": 2,
        "height": 1
      },
      {
        "id": "w4",
        "viewMode": "time",
        "width": 2,
        "height": 1
      },
      {
        "id": "w5",
        "viewMode": "timeline",
        "width": 4,
        "height": 2,
        "title": "Sessions over time, and the week before",
