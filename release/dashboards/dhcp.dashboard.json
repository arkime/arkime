{
  "name": "DHCP",
  "description": "DHCP sessions: protocols == dhcp",
  "data": {
    "version": 1,
    "folder": "Protocols",
    "colorScheme": "rainbow",
    "expression": "protocols == dhcp",
    "widgets": [
      {
        "id": "w0",
        "viewMode": "navigation",
        "width": 4,
        "height": 1
      },
      {
        "id": "w1",
        "viewMode": "timeline",
        "splitField": "dhcp.type",
        "splitLength": 5,
        "barMode": "stacked",
        "width": 3,
        "height": 2,
        "title": "DHCP sessions by dhcp.type"
      },
      {
        "id": "w2",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "DHCP sessions"
      },
      {
        "id": "w3",
        "viewMode": "metric",
        "width": 1,
        "height": 1,
        "title": "DHCP bytes",
        "metricType": "bytes"
      },
      {
        "id": "w4",
        "field": "dhcp.host",
        "viewMode": "tagcloud",
        "width": 2,
        "height": 2,
        "length": 20
      },
      {
        "id": "w5",
        "field": "dhcp.oui",
        "viewMode": "pie",
        "width": 2,
        "height": 2,
        "length": 8,
        "other": true
      },
      {
        "id": "w6",
        "field": "dhcp.mac",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20
      },
      {
        "id": "w7",
        "field": "dhcp.id",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20
      },
      {
        "id": "w8",
        "field": "dhcp.yiaddr",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "Assigned IPs"
      },
      {
        "id": "w9",
        "field": "dhcp.serverIp",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "title": "DHCP servers"
      },
      {
        "id": "w10",
        "field": "dhcp.yiaddr",
        "fields": [
          "dhcp.yiaddr",
          "dhcp.mac",
          "dhcp.host"
        ],
        "viewMode": "intersection",
        "width": 4,
        "height": 3,
        "title": "Assigned IPs by MAC and host name"
      },
      {
        "id": "w11",
        "field": "ip.src",
        "viewMode": "bar",
        "width": 2,
        "height": 3,
        "length": 15,
        "title": "Clients"
      },
      {
        "id": "w12",
        "field": "ip.dst:port",
        "viewMode": "table",
        "width": 2,
        "height": 3,
        "length": 20,
        "metrics": [
          "sessions",
          "bytes"
        ],
        "sortMetric": "sessions",
        "metricType": "sessions",
        "title": "Servers"
      },
      {
        "id": "w13",
        "field": "ip.src",
        "fields": [
          "ip.src",
          "ip.dst",
          "dhcp.type",
          "dhcp.host",
          "dhcp.mac",
          "dhcp.yiaddr"
        ],
        "viewMode": "sessions",
        "width": 4,
        "height": 3,
        "length": 20
      }
    ]
  }
}
