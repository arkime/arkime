INSTALL = @INSTALL@
MKDIR_P = mkdir -p
VIEWERDIR = $(DESTDIR)@prefix@/viewer
CP = /bin/cp
INSTALL_BUNDLE ?= "bundle:min"
CYBERCHEF_VERSION=11.4.0
CYBERCHEF_SHA=49d1a5634a67a3b806c6db0fdca7dcecb41a776c


all: arkimeparser.js

arkimeparser.js: arkimeparser.jison
	jison arkimeparser.jison

check:
	npm ci
	npm run bundle

cyberchef:
	(cd public ; if [ ! -f CyberChef_v$(CYBERCHEF_VERSION).zip ]; then curl -sSfL -o CyberChef_v$(CYBERCHEF_VERSION).zip https://github.com/gchq/CyberChef/releases/download/v$(CYBERCHEF_VERSION)/CyberChef_$(CYBERCHEF_SHA).zip; fi)

install: cyberchef
	$(MKDIR_P) "$(VIEWERDIR)" "$(VIEWERDIR)/vueapp"
	/bin/rm -f $(VIEWERDIR)/public/style.css
	$(INSTALL) *.js package.json package-lock.json $(VIEWERDIR)
	npm ci
	npm run $(INSTALL_BUNDLE)
	$(CP) -pr views public $(VIEWERDIR)
	$(CP) -pr vueapp/dist "$(VIEWERDIR)/vueapp"
	(cd $(VIEWERDIR) ; npm ci --omit=dev)

distclean realclean clean:
	rm -rf node_modules
	rm -rf bundle
	(cd vueapp ; rm -rf node_modules ; rm -rf dist)
